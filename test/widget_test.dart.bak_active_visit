import 'package:flutter_test/flutter_test.dart';
import 'package:shared_preferences/shared_preferences.dart';

import 'package:support_worker_log/app.dart';

void main() {
  TestWidgetsFlutterBinding.ensureInitialized();

  testWidgets('iPhone 13 mobile layout renders main sections', (tester) async {
    SharedPreferences.setMockInitialValues({});

    await tester.binding.setSurfaceSize(const Size(390, 844));
    addTearDown(() => tester.binding.setSurfaceSize(null));

    await tester.pumpWidget(const SupportWorkerLogApp());
    await tester.pumpAndSettle();

    expect(tester.takeException(), isNull);
    expect(find.text('Quick Entry'), findsOneWidget);

    for (final tab in ['Entries', 'Pay', 'Home', 'More']) {
      await tester.tap(find.text(tab).last);
      await tester.pumpAndSettle();

      final exception = tester.takeException();
      expect(exception, isNull, reason: '$tab failed: $exception');
    }

    for (final item in ['Tax', 'Charts', 'Settings']) {
      await tester.tap(find.text('More').last);
      await tester.pumpAndSettle();

      await tester.tap(find.text(item));
      await tester.pumpAndSettle();

      final exception = tester.takeException();
      expect(exception, isNull, reason: '$item failed: $exception');
    }
  });
}
