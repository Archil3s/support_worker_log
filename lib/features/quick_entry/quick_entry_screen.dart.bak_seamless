class _GlassPanel extends StatelessWidget {
  const _GlassPanel({
    required this.child,
    this.selected = false,
    this.onTap,
    this.padding = const EdgeInsets.all(16),
    this.width,
    this.height,
    this.borderColor,
    this.backgroundColor,
  });

  final Widget child;
  final bool selected;
  final VoidCallback? onTap;
  final EdgeInsetsGeometry padding;
  final double? width;
  final double? height;
  final Color? borderColor;
  final Color? backgroundColor;

  @override
  Widget build(BuildContext context) {
    final content = AnimatedContainer(
      duration: const Duration(milliseconds: 160),
      width: width,
      height: height,
      padding: padding,
      decoration: BoxDecoration(
        color: backgroundColor ?? (selected ? _Ux.blueSoft : _Ux.panel),
        borderRadius: _Ux.radius,
        border: Border.all(
          color: borderColor ?? (selected ? _Ux.blue : _Ux.border),
          width: selected ? 2 : 1,
        ),
        boxShadow: const [
          BoxShadow(
            color: Color(0x66000000),
            blurRadius: 24,
            offset: Offset(0, 12),
          ),
        ],
      ),
      child: child,
    );

    if (onTap == null) return content;

    return InkWell(borderRadius: _Ux.radius, onTap: onTap, child: content);
  }
}

class _IconBubble extends StatelessWidget {
  const _IconBubble({required this.text, required this.selected});

  final String text;
  final bool selected;

  @override
  Widget build(BuildContext context) {
    return Container(
      width: 46,
      height: 46,
      alignment: Alignment.center,
      decoration: BoxDecoration(
        color: selected ? const Color(0xFF173765) : _Ux.panelStrong,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(color: selected ? _Ux.blue : _Ux.borderSoft),
      ),
      child: Text(text, style: const TextStyle(fontSize: 22)),
    );
  }
}
