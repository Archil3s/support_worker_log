import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '../../core/models/entry_type.dart';
import '../../core/models/work_entry.dart';
import '../../core/state/app_state.dart';
import '../../core/utils/formatters.dart';
import '../../core/utils/pay_period_utils.dart';

class QuickEntryScreen extends StatefulWidget {
  const QuickEntryScreen({super.key});

  @override
  State<QuickEntryScreen> createState() => _QuickEntryScreenState();
}

class _QuickEntryScreenState extends State<QuickEntryScreen> {
  static const int stepCount = 8;

  final pageController = PageController();
  final startOdometerController = TextEditingController();
  final finishOdometerController = TextEditingController();
  final noteController = TextEditingController();

  int stepIndex = 0;
  String? selectedClient;
  EntryType selectedType = EntryType.homeVisit;
  DateTime selectedDate = DateTime.now();
  DateTime? startedAt;
  DateTime? finishedAt;
  bool saved = false;

  final selectedNotes = <String>{};

  @override
  void dispose() {
    pageController.dispose();
    startOdometerController.dispose();
    finishOdometerController.dispose();
    noteController.dispose();
    super.dispose();
  }

  Duration get elapsed {
    if (startedAt == null || finishedAt == null) return Duration.zero;

    var end = finishedAt!;
    if (!end.isAfter(startedAt!)) {
      end = end.add(const Duration(days: 1));
    }

    return end.difference(startedAt!);
  }

  int get billableMinutes {
    if (elapsed.inSeconds <= 0) return 0;
    return (elapsed.inSeconds / 60).ceil().clamp(1, 1440).toInt();
  }

  String get elapsedText {
    if (elapsed == Duration.zero) return '-';

    final hours = elapsed.inHours;
    final minutes = elapsed.inMinutes.remainder(60);
    final seconds = elapsed.inSeconds.remainder(60);

    if (hours > 0) return '${hours}h ${minutes}m ${seconds}s';
    if (minutes > 0) return '${minutes}m ${seconds}s';
    return '${seconds}s';
  }

  double? get startOdometer => _parseOdometer(startOdometerController);
  double? get finishOdometer => _parseOdometer(finishOdometerController);

  double get kilometres {
    if (selectedType != EntryType.homeVisit) return 0;
    if (startOdometer == null || finishOdometer == null) return 0;

    final value = finishOdometer! - startOdometer!;
    return value < 0 ? 0 : value;
  }

  double? _parseOdometer(TextEditingController controller) {
    final text = controller.text.trim();
    if (text.isEmpty) return null;
    return double.tryParse(text);
  }

  void _goTo(int index) {
    final next = index.clamp(0, stepCount - 1).toInt();

    setState(() => stepIndex = next);

    pageController.animateToPage(
      next,
      duration: const Duration(milliseconds: 220),
      curve: Curves.easeOut,
    );
  }

  void _next() {
    if (stepIndex == 0 && selectedClient == null) {
      _toast('Tap a client first.');
      return;
    }

    if (stepIndex == 2 && startedAt == null) {
      _toast('Press Start Now first.');
      return;
    }

    if (stepIndex == 3 && selectedType != EntryType.homeVisit) {
      _goTo(4);
      return;
    }

    if (stepIndex == 4 && finishedAt == null) {
      _toast('Press Finish Now first.');
      return;
    }

    if (stepIndex == 5 && selectedType != EntryType.homeVisit) {
      _goTo(6);
      return;
    }

    _goTo(stepIndex + 1);
  }

  void _back() {
    if (stepIndex == 6 && selectedType != EntryType.homeVisit) {
      _goTo(4);
      return;
    }

    if (stepIndex == 4 && selectedType != EntryType.homeVisit) {
      _goTo(2);
      return;
    }

    _goTo(stepIndex - 1);
  }

  void _setStartNow() {
    final now = DateTime.now();

    setState(() {
      selectedDate = DateTime(now.year, now.month, now.day);
      startedAt = now;
      finishedAt = null;
    });

    _toast('Start time stored.');
    Future.delayed(const Duration(milliseconds: 250), () {
      if (!mounted) return;
      _goTo(selectedType == EntryType.homeVisit ? 3 : 4);
    });
  }

  void _setFinishNow() {
    if (startedAt == null) {
      _toast('Press Start Now first.');
      _goTo(2);
      return;
    }

    setState(() => finishedAt = DateTime.now());

    _toast('Finish time stored.');
    Future.delayed(const Duration(milliseconds: 250), () {
      if (!mounted) return;
      _goTo(selectedType == EntryType.homeVisit ? 5 : 6);
    });
  }

  Future<void> _pickDate() async {
    final picked = await showDatePicker(
      context: context,
      initialDate: selectedDate,
      firstDate: DateTime(2020),
      lastDate: DateTime(2100),
    );

    if (picked == null) return;

    setState(() {
      selectedDate = picked;

      if (startedAt != null) {
        startedAt = DateTime(
          picked.year,
          picked.month,
          picked.day,
          startedAt!.hour,
          startedAt!.minute,
          startedAt!.second,
        );
      }

      if (finishedAt != null) {
        finishedAt = DateTime(
          picked.year,
          picked.month,
          picked.day,
          finishedAt!.hour,
          finishedAt!.minute,
          finishedAt!.second,
        );
      }
    });
  }

  String _formatDateTime(DateTime dateTime) {
    final time = TimeOfDay.fromDateTime(dateTime).format(context);
    return '${formatDate(dateTime)} $time';
  }

  Future<void> _save() async {
    final client = selectedClient;

    if (client == null) {
      _toast('Tap a client first.');
      _goTo(0);
      return;
    }

    if (startedAt == null) {
      _toast('Press Start Now first.');
      _goTo(2);
      return;
    }

    if (finishedAt == null) {
      _toast('Press Finish Now first.');
      _goTo(4);
      return;
    }

    if (billableMinutes <= 0) {
      _toast('Finish time must be after start time.');
      _goTo(4);
      return;
    }

    if (selectedType == EntryType.homeVisit &&
        startOdometer != null &&
        finishOdometer != null &&
        finishOdometer! < startOdometer!) {
      _toast('Finish odometer must be higher than start odometer.');
      _goTo(5);
      return;
    }

    final customNote = noteController.text.trim();
    final notes = {
      ...selectedNotes,
      if (customNote.isNotEmpty) customNote,
    }.toList()..sort();

    final entry = WorkEntry(
      id: DateTime.now().microsecondsSinceEpoch.toString(),
      client: client,
      type: selectedType,
      date: DateTime(startedAt!.year, startedAt!.month, startedAt!.day),
      startTime: TimeOfDay.fromDateTime(startedAt!),
      minutes: billableMinutes,
      notes: notes,
      odometerStart: selectedType == EntryType.homeVisit ? startOdometer : null,
      odometerEnd: selectedType == EntryType.homeVisit ? finishOdometer : null,
    );

    context.read<AppState>().addEntry(entry);

    setState(() {
      saved = true;
      stepIndex = 0;
      startedAt = null;
      finishedAt = null;
      selectedNotes.clear();
      startOdometerController.clear();
      finishOdometerController.clear();
      noteController.clear();
    });
  }

  void _toast(String message) {
    ScaffoldMessenger.of(
      context,
    ).showSnackBar(SnackBar(content: Text(message)));
  }

  void _startAnother() {
    setState(() {
      saved = false;
      stepIndex = 0;
      selectedDate = DateTime.now();
      startedAt = null;
      finishedAt = null;
    });

    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!pageController.hasClients) return;
      pageController.jumpToPage(0);
    });
  }

  @override
  Widget build(BuildContext context) {
    final appState = context.watch<AppState>();
    final clients = appState.clients;

    if (selectedClient != null && !clients.contains(selectedClient)) {
      selectedClient = null;
    }

    if (saved) {
      return _DarkScaffold(child: _SavedScreen(onNewEntry: _startAnother));
    }

    final range = currentFortnight();

    return _DarkScaffold(
      child: Column(
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(24, 18, 24, 0),
            child: Column(
              children: [
                _ProgressHeader(
                  stepIndex: stepIndex,
                  stepCount: stepCount,
                  periodText:
                      '${formatDate(range.start)} - ${formatDate(range.end)}',
                ),
                const SizedBox(height: 12),
                _StatusPanel(
                  client: selectedClient,
                  type: selectedType,
                  startText: startedAt == null
                      ? '-'
                      : _formatDateTime(startedAt!),
                  finishText: finishedAt == null
                      ? '-'
                      : _formatDateTime(finishedAt!),
                  elapsedText: elapsedText,
                  billableMinutes: billableMinutes,
                ),
              ],
            ),
          ),
          Expanded(
            child: PageView(
              controller: pageController,
              physics: const NeverScrollableScrollPhysics(),
              onPageChanged: (index) => setState(() => stepIndex = index),
              children: [
                _StepPage(
                  title: 'Who are you supporting?',
                  subtitle: 'Tap a client card to continue.',
                  showBack: false,
                  onBack: _back,
                  onNext: _next,
                  child: _clientStep(clients),
                ),
                _StepPage(
                  title: 'What type of support?',
                  subtitle: 'Tap the support type to continue.',
                  onBack: _back,
                  onNext: _next,
                  child: _typeStep(),
                ),
                _StepPage(
                  title: 'Start support',
                  subtitle: 'Press Start Now when you begin.',
                  onBack: _back,
                  onNext: _next,
                  child: _startStep(),
                ),
                _StepPage(
                  title: 'Starting odometer',
                  subtitle: 'Enter this before travelling.',
                  onBack: _back,
                  onNext: _next,
                  child: _startOdometerStep(),
                ),
                _StepPage(
                  title: 'Finish support',
                  subtitle: 'Press Finish Now when you end.',
                  onBack: _back,
                  onNext: _next,
                  child: _finishStep(appState.settings.hourlyRate),
                ),
                _StepPage(
                  title: 'Finishing odometer',
                  subtitle: 'Enter this after travelling.',
                  onBack: _back,
                  onNext: _next,
                  child: _finishOdometerStep(),
                ),
                _StepPage(
                  title: 'Support notes',
                  subtitle: 'Tap common notes. Type only if needed.',
                  onBack: _back,
                  onNext: _next,
                  topAction: TextButton(
                    onPressed: _next,
                    child: const Text('Skip notes'),
                  ),
                  child: _notesStep(appState.settings.noteOptions),
                ),
                _StepPage(
                  title: 'Review and save',
                  subtitle: 'Final check before saving.',
                  onBack: _back,
                  onNext: _save,
                  isLast: true,
                  child: _reviewStep(),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _clientStep(List<String> clients) {
    if (clients.isEmpty) {
      return const _InfoPanel(text: 'Add clients in Settings first.');
    }

    return Wrap(
      spacing: 12,
      runSpacing: 12,
      children: [
        for (final client in clients)
          _ClientCard(
            label: client,
            selected: selectedClient == client,
            onTap: () {
              setState(() => selectedClient = client);
              _next();
            },
          ),
      ],
    );
  }

  Widget _typeStep() {
    return Column(
      children: [
        _TypeCard(
          icon: Icons.home_work_outlined,
          title: EntryType.homeVisit.label,
          subtitle: 'Visit with travel and odometer',
          selected: selectedType == EntryType.homeVisit,
          onTap: () {
            setState(() => selectedType = EntryType.homeVisit);
            _next();
          },
        ),
        _TypeCard(
          icon: Icons.handshake_outlined,
          title: EntryType.professionalContact.label,
          subtitle: 'Meeting, coordination, provider contact',
          selected: selectedType == EntryType.professionalContact,
          onTap: () {
            setState(() => selectedType = EntryType.professionalContact);
            _next();
          },
        ),
        _TypeCard(
          icon: Icons.phone_outlined,
          title: EntryType.phoneCall.label,
          subtitle: 'Phone support or check-in',
          selected: selectedType == EntryType.phoneCall,
          onTap: () {
            setState(() => selectedType = EntryType.phoneCall);
            _next();
          },
        ),
        _TypeCard(
          icon: Icons.sms_outlined,
          title: EntryType.textNote.label,
          subtitle: 'Written note or message record',
          selected: selectedType == EntryType.textNote,
          onTap: () {
            setState(() => selectedType = EntryType.textNote);
            _next();
          },
        ),
      ],
    );
  }

  Widget _startStep() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DatePanel(
          label: 'Entry date',
          value: formatDate(selectedDate),
          onTap: _pickDate,
        ),
        const SizedBox(height: 12),
        _TimePanel(
          label: 'Start time',
          value: startedAt == null
              ? 'Not started yet'
              : _formatDateTime(startedAt!),
        ),
        const SizedBox(height: 16),
        _PrimaryActionButton(
          icon: Icons.play_arrow_rounded,
          label: startedAt == null ? 'Start Now' : 'Restart Now',
          onPressed: _setStartNow,
        ),
        const SizedBox(height: 12),
        const _InfoPanel(
          text:
              'This stores the exact current time. No manual time entry is needed.',
        ),
      ],
    );
  }

  Widget _startOdometerStep() {
    if (selectedType != EntryType.homeVisit) {
      return const _InfoPanel(text: 'No odometer needed. Tap Next.');
    }

    return _DarkTextField(
      controller: startOdometerController,
      label: 'Starting odometer',
      keyboardType: const TextInputType.numberWithOptions(decimal: true),
    );
  }

  Widget _finishStep(double hourlyRate) {
    final gross = (billableMinutes / 60) * hourlyRate;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _TimePanel(
          label: 'Finish time',
          value: finishedAt == null
              ? 'Not finished yet'
              : _formatDateTime(finishedAt!),
        ),
        const SizedBox(height: 16),
        _PrimaryActionButton(
          icon: Icons.stop_rounded,
          label: finishedAt == null ? 'Finish Now' : 'Update Finish Time',
          onPressed: _setFinishNow,
          green: true,
        ),
        const SizedBox(height: 16),
        _EarnedPanel(
          amount: gross,
          elapsedText: elapsedText,
          billableMinutes: billableMinutes,
        ),
      ],
    );
  }

  Widget _finishOdometerStep() {
    if (selectedType != EntryType.homeVisit) {
      return const _InfoPanel(text: 'No odometer needed. Tap Next.');
    }

    final start = startOdometer;
    final finish = finishOdometer;
    final km = start == null || finish == null ? null : finish - start;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkTextField(
          controller: finishOdometerController,
          label: 'Finishing odometer',
          keyboardType: const TextInputType.numberWithOptions(decimal: true),
          onChanged: (_) => setState(() {}),
        ),
        const SizedBox(height: 12),
        if (km != null)
          _InfoPanel(
            text: km < 0
                ? 'Finish odometer must be higher than start.'
                : 'KM preview: ${km.toStringAsFixed(1)} km',
          ),
      ],
    );
  }

  Widget _notesStep(List<String> noteOptions) {
    final visitNotes = noteOptions
        .where((note) => !_schedulingNotes.contains(note))
        .toList();
    final schedulingNotes = noteOptions
        .where((note) => _schedulingNotes.contains(note))
        .toList();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkTextField(
          controller: noteController,
          label: 'Optional typed note',
          minLines: 4,
          maxLines: 5,
        ),
        const SizedBox(height: 14),
        _ChipGroup(
          title: 'Support provided',
          notes: visitNotes,
          selectedNotes: selectedNotes,
          onChanged: () => setState(() {}),
        ),
        const SizedBox(height: 14),
        _ChipGroup(
          title: 'Scheduling',
          notes: schedulingNotes,
          selectedNotes: selectedNotes,
          onChanged: () => setState(() {}),
        ),
      ],
    );
  }

  Widget _reviewStep() {
    final settings = context.watch<AppState>().settings;
    final gross = (billableMinutes / 60) * settings.hourlyRate;
    final taxSetAside =
        gross *
        (settings.gstRate +
            settings.accRate +
            (settings.kiwiSaverEnabled ? settings.kiwiSaverRate : 0));
    final net = gross - taxSetAside;
    final customNote = noteController.text.trim();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _ReviewRow(label: 'Client', value: selectedClient ?? '-'),
        _ReviewRow(label: 'Type', value: selectedType.label),
        _ReviewRow(label: 'Date', value: formatDate(selectedDate)),
        _ReviewRow(
          label: 'Start',
          value: startedAt == null ? '-' : _formatDateTime(startedAt!),
        ),
        _ReviewRow(
          label: 'Finish',
          value: finishedAt == null ? '-' : _formatDateTime(finishedAt!),
        ),
        _ReviewRow(label: 'Elapsed', value: elapsedText),
        _ReviewRow(label: 'Billable', value: '$billableMinutes min'),
        if (selectedType == EntryType.homeVisit)
          _ReviewRow(
            label: 'Odometer',
            value:
                '${startOdometerController.text.trim().isEmpty ? '-' : startOdometerController.text.trim()} -> ${finishOdometerController.text.trim().isEmpty ? '-' : finishOdometerController.text.trim()}',
          ),
        if (selectedType == EntryType.homeVisit)
          _ReviewRow(label: 'KM', value: kilometres.toStringAsFixed(1)),
        _ReviewRow(label: 'Gross', value: money(gross), highlight: true),
        _ReviewRow(label: 'Tax set-aside', value: money(taxSetAside)),
        _ReviewRow(label: 'Net', value: money(net), highlight: true),
        if (selectedNotes.isNotEmpty || customNote.isNotEmpty) ...[
          const SizedBox(height: 14),
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: [
              for (final note in selectedNotes.toList()..sort())
                Chip(label: Text(note)),
              if (customNote.isNotEmpty) Chip(label: Text(customNote)),
            ],
          ),
        ],
      ],
    );
  }
}

const _schedulingNotes = {
  'Cancelled',
  'No Show',
  'Rescheduled',
  'Client Rescheduled',
  'Late Cancel',
  'Cut Short',
  'Follow-up Needed',
};

class _C {
  static const bg = Color(0xFF090E17);
  static const panel = Color(0xFF151B29);
  static const panel2 = Color(0xFF20283B);
  static const border = Color(0xFF34405F);
  static const borderSoft = Color(0xFF27324B);
  static const blue = Color(0xFF4F8DF7);
  static const blueSoft = Color(0xFF13294D);
  static const green = Color(0xFF31E981);
  static const greenBorder = Color(0xFF128A45);
  static const muted = Color(0xFF8396C7);
  static const text = Colors.white;
}

class _DarkScaffold extends StatelessWidget {
  const _DarkScaffold({required this.child});

  final Widget child;

  @override
  Widget build(BuildContext context) {
    return Theme(
      data: Theme.of(context).copyWith(
        scaffoldBackgroundColor: _C.bg,
        canvasColor: _C.panel,
        textTheme: Theme.of(
          context,
        ).textTheme.apply(bodyColor: _C.text, displayColor: _C.text),
        chipTheme: ChipThemeData(
          backgroundColor: _C.panel2,
          selectedColor: _C.blueSoft,
          labelStyle: const TextStyle(
            color: Color(0xFFD8E2FF),
            fontWeight: FontWeight.w700,
          ),
          secondaryLabelStyle: const TextStyle(
            color: Colors.white,
            fontWeight: FontWeight.w900,
          ),
          side: const BorderSide(color: _C.border),
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(999),
          ),
        ),
      ),
      child: ColoredBox(color: _C.bg, child: child),
    );
  }
}

class _Panel extends StatelessWidget {
  const _Panel({
    required this.child,
    this.selected = false,
    this.onTap,
    this.padding = const EdgeInsets.all(16),
    this.background,
    this.border,
    this.width,
    this.height,
  });

  final Widget child;
  final bool selected;
  final VoidCallback? onTap;
  final EdgeInsetsGeometry padding;
  final Color? background;
  final Color? border;
  final double? width;
  final double? height;

  @override
  Widget build(BuildContext context) {
    final content = AnimatedContainer(
      duration: const Duration(milliseconds: 160),
      width: width,
      height: height,
      padding: padding,
      decoration: BoxDecoration(
        color: background ?? (selected ? _C.blueSoft : _C.panel),
        borderRadius: BorderRadius.circular(18),
        border: Border.all(
          color: border ?? (selected ? _C.blue : _C.border),
          width: selected ? 2 : 1,
        ),
        boxShadow: const [
          BoxShadow(
            color: Color(0x55000000),
            blurRadius: 22,
            offset: Offset(0, 10),
          ),
        ],
      ),
      child: child,
    );

    if (onTap == null) return content;

    return InkWell(
      borderRadius: BorderRadius.circular(18),
      onTap: onTap,
      child: content,
    );
  }
}

class _ProgressHeader extends StatelessWidget {
  const _ProgressHeader({
    required this.stepIndex,
    required this.stepCount,
    required this.periodText,
  });

  final int stepIndex;
  final int stepCount;
  final String periodText;

  @override
  Widget build(BuildContext context) {
    final progress = (stepIndex + 1) / stepCount;

    return _Panel(
      padding: const EdgeInsets.all(16),
      child: Column(
        children: [
          ClipRRect(
            borderRadius: BorderRadius.circular(999),
            child: LinearProgressIndicator(
              value: progress,
              minHeight: 6,
              backgroundColor: _C.borderSoft,
              valueColor: const AlwaysStoppedAnimation(_C.blue),
            ),
          ),
          const SizedBox(height: 12),
          Row(
            children: [
              Text('STEP ${stepIndex + 1} OF $stepCount', style: _label()),
              const Spacer(),
              Flexible(
                child: Text(
                  periodText,
                  textAlign: TextAlign.right,
                  overflow: TextOverflow.ellipsis,
                  style: _label(),
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }
}

class _StatusPanel extends StatelessWidget {
  const _StatusPanel({
    required this.client,
    required this.type,
    required this.startText,
    required this.finishText,
    required this.elapsedText,
    required this.billableMinutes,
  });

  final String? client;
  final EntryType type;
  final String startText;
  final String finishText;
  final String elapsedText;
  final int billableMinutes;

  @override
  Widget build(BuildContext context) {
    return _Panel(
      background: const Color(0xFF101827),
      border: _C.borderSoft,
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.stretch,
        children: [
          Text('Current entry', style: _label()),
          const SizedBox(height: 10),
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: [
              _StatusPill(
                icon: Icons.person_rounded,
                text: client ?? 'No client',
                active: client != null,
              ),
              _StatusPill(icon: type.icon, text: type.label, active: true),
              _StatusPill(
                icon: Icons.play_arrow_rounded,
                text: startText == '-' ? 'Not started' : startText,
                active: startText != '-',
              ),
              _StatusPill(
                icon: Icons.stop_rounded,
                text: finishText == '-' ? 'Not finished' : finishText,
                active: finishText != '-',
              ),
              _StatusPill(
                icon: Icons.timer_outlined,
                text: billableMinutes == 0
                    ? 'No time yet'
                    : '$elapsedText / $billableMinutes min',
                active: billableMinutes > 0,
              ),
            ],
          ),
        ],
      ),
    );
  }
}

class _StatusPill extends StatelessWidget {
  const _StatusPill({
    required this.icon,
    required this.text,
    required this.active,
  });

  final IconData icon;
  final String text;
  final bool active;

  @override
  Widget build(BuildContext context) {
    return Container(
      padding: const EdgeInsets.symmetric(horizontal: 11, vertical: 8),
      decoration: BoxDecoration(
        color: active ? _C.blueSoft : const Color(0xFF1A2131),
        borderRadius: BorderRadius.circular(999),
        border: Border.all(color: active ? _C.blue : _C.borderSoft),
      ),
      child: Row(
