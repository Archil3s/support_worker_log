        children: [
          const Text(
            'EARNED SO FAR',
            style: TextStyle(
              color: Color(0xFF31E981),
              fontWeight: FontWeight.w900,
              letterSpacing: 1.2,
            ),
          ),
          const SizedBox(height: 8),
          Text(
            money(amount),
            style: const TextStyle(
              color: Color(0xFF31E981),
              fontSize: 38,
              fontWeight: FontWeight.w900,
            ),
