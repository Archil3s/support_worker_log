import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

import '../../core/models/entry_type.dart';
import '../../core/models/work_entry.dart';
import '../../core/state/app_state.dart';
import '../../core/utils/formatters.dart';
import '../../core/utils/pay_period_utils.dart';

class QuickEntryScreen extends StatefulWidget {
  const QuickEntryScreen({super.key});

  @override
  State<QuickEntryScreen> createState() => _QuickEntryScreenState();
}

class _QuickEntryScreenState extends State<QuickEntryScreen> {
  static const int stepCount = 9;

  final pageController = PageController();
  final startOdometerController = TextEditingController();
  final finishOdometerController = TextEditingController();
  final noteController = TextEditingController();

  int stepIndex = 0;
  String? selectedClient;
  EntryType selectedType = EntryType.homeVisit;
  DateTime selectedDate = DateTime.now();
  TimeOfDay? startTime;
  TimeOfDay? finishTime;
  bool saved = false;

  final selectedNotes = <String>{};

  @override
  void dispose() {
    pageController.dispose();
    startOdometerController.dispose();
    finishOdometerController.dispose();
    noteController.dispose();
    super.dispose();
  }

  int get totalMinutes {
    if (startTime == null || finishTime == null) return 0;

    final start = DateTime(
      selectedDate.year,
      selectedDate.month,
      selectedDate.day,
      startTime!.hour,
      startTime!.minute,
    );

    var finish = DateTime(
      selectedDate.year,
      selectedDate.month,
      selectedDate.day,
      finishTime!.hour,
      finishTime!.minute,
    );

    if (!finish.isAfter(start)) {
      finish = finish.add(const Duration(days: 1));
    }

    return finish.difference(start).inMinutes.clamp(1, 1440).toInt();
  }

  double? get startOdometer => _parseOdometer(startOdometerController);
  double? get finishOdometer => _parseOdometer(finishOdometerController);

  double get kilometres {
    if (selectedType != EntryType.homeVisit) return 0;
    if (startOdometer == null || finishOdometer == null) return 0;

    final value = finishOdometer! - startOdometer!;
    return value < 0 ? 0 : value;
  }

  double? _parseOdometer(TextEditingController controller) {
    final text = controller.text.trim();
    if (text.isEmpty) return null;
    return double.tryParse(text);
  }

  void _goTo(int index) {
    final next = index.clamp(0, stepCount - 1).toInt();

    setState(() => stepIndex = next);

    pageController.animateToPage(
      next,
      duration: const Duration(milliseconds: 220),
      curve: Curves.easeOut,
    );
  }

  void _next() => _goTo(stepIndex + 1);
  void _back() => _goTo(stepIndex - 1);

  void _setStartNow() {
    final now = DateTime.now();

    setState(() {
      selectedDate = DateTime(now.year, now.month, now.day);
      startTime = TimeOfDay.fromDateTime(now);
      finishTime = null;
    });
  }

  void _setFinishNow() {
    final now = DateTime.now();
    setState(() => finishTime = TimeOfDay.fromDateTime(now));
  }

  Future<void> _pickDate() async {
    final picked = await showDatePicker(
      context: context,
      initialDate: selectedDate,
      firstDate: DateTime(2020),
      lastDate: DateTime(2100),
    );

    if (picked == null) return;

    setState(() => selectedDate = picked);
  }

  Future<void> _save() async {
    final client = selectedClient;

    if (client == null) {
      _toast('Tap a client first.');
      _goTo(0);
      return;
    }

    if (startTime == null) {
      _toast('Press Start Right Now first.');
      _goTo(3);
      return;
    }

    if (finishTime == null) {
      _toast('Press Set to current finish time first.');
      _goTo(5);
      return;
    }

    if (selectedType == EntryType.homeVisit &&
        startOdometer != null &&
        finishOdometer != null &&
        finishOdometer! < startOdometer!) {
      _toast('Finish odometer must be higher than start odometer.');
      _goTo(6);
      return;
    }

    final customNote = noteController.text.trim();
    final notes = [
      ...selectedNotes,
      if (customNote.isNotEmpty) customNote,
    ].toSet().toList()
      ..sort();

    final entry = WorkEntry(
      id: DateTime.now().microsecondsSinceEpoch.toString(),
      client: client,
      type: selectedType,
      date: selectedDate,
      startTime: startTime!,
      minutes: totalMinutes,
      notes: notes,
      odometerStart: selectedType == EntryType.homeVisit ? startOdometer : null,
      odometerEnd: selectedType == EntryType.homeVisit ? finishOdometer : null,
    );

    context.read<AppState>().addEntry(entry);

    setState(() {
      saved = true;
      stepIndex = 0;
      startTime = null;
      finishTime = null;
      selectedNotes.clear();
      startOdometerController.clear();
      finishOdometerController.clear();
      noteController.clear();
    });
  }

  void _toast(String message) {
    ScaffoldMessenger.of(context).showSnackBar(SnackBar(content: Text(message)));
  }

  void _startAnother() {
    setState(() {
      saved = false;
      stepIndex = 0;
      selectedDate = DateTime.now();
      startTime = null;
      finishTime = null;
    });

    WidgetsBinding.instance.addPostFrameCallback((_) {
      if (!pageController.hasClients) return;
      pageController.jumpToPage(0);
    });
  }

  @override
  Widget build(BuildContext context) {
    final appState = context.watch<AppState>();
    final clients = appState.clients;

    if (selectedClient == null && clients.isNotEmpty) {
      selectedClient = clients.first;
    }

    if (saved) {
      return _DarkShell(
        child: _SavedStep(onNewEntry: _startAnother),
      );
    }

    final range = currentFortnight();

    return _DarkShell(
      child: Column(
        children: [
          Padding(
            padding: const EdgeInsets.fromLTRB(28, 18, 28, 0),
            child: _ProgressHeader(
              stepIndex: stepIndex,
              stepCount: stepCount,
              periodText: '${formatDate(range.start)} - ${formatDate(range.end)}',
            ),
          ),
          Expanded(
            child: PageView(
              controller: pageController,
              physics: const NeverScrollableScrollPhysics(),
              onPageChanged: (index) => setState(() => stepIndex = index),
              children: [
                _StepFrame(
                  title: 'Who are you visiting?',
                  subtitle: 'Select the client for this entry.',
                  showBack: false,
                  onBack: _back,
                  onNext: _next,
                  child: _clientStep(clients),
                ),
                _StepFrame(
                  title: 'Contact type?',
                  subtitle: 'What kind of interaction is this?',
                  onBack: _back,
                  onNext: _next,
                  child: _typeStep(),
                ),
                _StepFrame(
                  title: 'What date?',
                  subtitle: 'When did this contact happen?',
                  onBack: _back,
                  onNext: _next,
                  child: _dateStep(),
                ),
                _StepFrame(
                  title: 'What time did you start?',
                  subtitle: 'Press Start Right Now when the contact starts.',
                  onBack: _back,
                  onNext: _next,
                  child: _startTimeStep(),
                ),
                _StepFrame(
                  title: 'Odometer - start',
                  subtitle: selectedType == EntryType.homeVisit
                      ? 'Record your reading before leaving.'
                      : 'No odometer is needed for this contact type.',
                  onBack: _back,
                  onNext: _next,
                  child: _startOdometerStep(),
                ),
                _StepFrame(
                  title: 'What time did you finish?',
                  subtitle: 'Press the button when the contact ends.',
                  onBack: _back,
                  onNext: _next,
                  child: _finishTimeStep(appState.settings.hourlyRate),
                ),
                _StepFrame(
                  title: 'Odometer - finish',
                  subtitle: selectedType == EntryType.homeVisit
                      ? 'Record your reading after arriving.'
                      : 'No odometer is needed for this contact type.',
                  onBack: _back,
                  onNext: _next,
                  child: _finishOdometerStep(),
                ),
                _StepFrame(
                  title: 'Any notes?',
                  subtitle: 'Optional - tap Skip if nothing to add.',
                  onBack: _back,
                  onNext: _next,
                  nextLabel: 'Next ->',
                  trailingTopAction: TextButton(
                    onPressed: _next,
                    child: const Text('Skip ->'),
                  ),
                  child: _notesStep(appState.settings.noteOptions),
                ),
                _StepFrame(
                  title: 'Ready to save?',
                  subtitle: 'Check everything looks right before saving.',
                  onBack: _back,
                  onNext: _save,
                  isLast: true,
                  child: _reviewStep(),
                ),
              ],
            ),
          ),
        ],
      ),
    );
  }

  Widget _clientStep(List<String> clients) {
    if (clients.isEmpty) {
      return const _InfoPanel(text: 'Add clients in Settings first.');
    }

    return Wrap(
      spacing: 12,
      runSpacing: 12,
      children: [
        for (final client in clients)
          _ClientButton(
            label: client,
            selected: selectedClient == client,
            onTap: () {
              setState(() => selectedClient = client);
              _next();
            },
          ),
      ],
    );
  }

  Widget _typeStep() {
    return Column(
      children: [
        _ContactTypeButton(
          icon: '🏠',
          title: EntryType.homeVisit.label,
          subtitle: 'Includes odometer & travel',
          selected: selectedType == EntryType.homeVisit,
          onTap: () {
            setState(() => selectedType = EntryType.homeVisit);
            _next();
          },
        ),
        _ContactTypeButton(
          icon: '💼',
          title: EntryType.professionalContact.label,
          subtitle: 'Meetings, coordination',
          selected: selectedType == EntryType.professionalContact,
          onTap: () {
            setState(() => selectedType = EntryType.professionalContact);
            _next();
          },
        ),
        _ContactTypeButton(
          icon: '📞',
          title: EntryType.phoneCall.label,
          subtitle: 'Remote check-in',
          selected: selectedType == EntryType.phoneCall,
          onTap: () {
            setState(() => selectedType = EntryType.phoneCall);
            _next();
          },
        ),
        _ContactTypeButton(
          icon: '💬',
          title: EntryType.textNote.label,
          subtitle: 'Written record only',
          selected: selectedType == EntryType.textNote,
          onTap: () {
            setState(() => selectedType = EntryType.textNote);
            _next();
          },
        ),
      ],
    );
  }

  Widget _dateStep() {
    final isToday = DateUtils.isSameDay(selectedDate, DateTime.now());

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkInputButton(
          text: formatDate(selectedDate),
          icon: Icons.calendar_month_outlined,
          onTap: _pickDate,
        ),
        const SizedBox(height: 16),
        _GreenOutlinePanel(
          text: isToday ? '✓ Today selected' : 'Selected date saved',
        ),
      ],
    );
  }

  Widget _startTimeStep() {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkInputButton(
          text: startTime == null ? '--:-- --' : formatTime(startTime!),
          icon: Icons.schedule_outlined,
          onTap: _setStartNow,
        ),
        const SizedBox(height: 16),
        _LargeActionButton(
          label: startTime == null
              ? '⏱ Start Right Now'
              : '✓ Started at ${formatTime(startTime!)}',
          onPressed: _setStartNow,
        ),
      ],
    );
  }

  Widget _startOdometerStep() {
    if (selectedType != EntryType.homeVisit) {
      return const _InfoPanel(text: 'Skip this step for non-visit contacts.');
    }

    return _DarkTextField(
      controller: startOdometerController,
      label: 'Starting odometer',
      keyboardType: TextInputType.number,
    );
  }

  Widget _finishTimeStep(double hourlyRate) {
    final gross = (totalMinutes / 60) * hourlyRate;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkInputButton(
          text: finishTime == null ? '--:-- --' : formatTime(finishTime!),
          icon: Icons.schedule_outlined,
          onTap: _setFinishNow,
        ),
        const SizedBox(height: 16),
        _GreenOutlinePanel(
          text: finishTime == null
              ? 'Set to current time'
              : '✓ Set to ${formatTime(finishTime!)}',
          onTap: _setFinishNow,
        ),
        const SizedBox(height: 16),
        _EarnedPanel(
          amount: gross,
          minutes: totalMinutes,
        ),
      ],
    );
  }

  Widget _finishOdometerStep() {
    if (selectedType != EntryType.homeVisit) {
      return const _InfoPanel(text: 'Skip this step for non-visit contacts.');
    }

    final start = startOdometer;
    final finish = finishOdometer;
    final km = start == null || finish == null ? null : finish - start;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkTextField(
          controller: finishOdometerController,
          label: 'Finishing odometer',
          keyboardType: TextInputType.number,
          onChanged: (_) => setState(() {}),
        ),
        const SizedBox(height: 12),
        if (km != null)
          _InfoPanel(
            text: km < 0
                ? 'Finish odometer must be higher than start.'
                : 'KM preview: ${km.toStringAsFixed(1)} km',
          ),
      ],
    );
  }

  Widget _notesStep(List<String> noteOptions) {
    final visitNotes = noteOptions
        .where((note) => !_schedulingNotes.contains(note))
        .toList();
    final schedulingNotes = noteOptions
        .where((note) => _schedulingNotes.contains(note))
        .toList();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _DarkTextField(
          controller: noteController,
          label: 'Visit notes...',
          minLines: 4,
          maxLines: 5,
        ),
        const SizedBox(height: 18),
        _ChipGroup(
          title: 'VISIT',
          notes: visitNotes,
          selectedNotes: selectedNotes,
          onChanged: () => setState(() {}),
        ),
        const SizedBox(height: 18),
        _ChipGroup(
          title: 'SCHEDULING',
          notes: schedulingNotes,
          selectedNotes: selectedNotes,
          onChanged: () => setState(() {}),
        ),
      ],
    );
  }

  Widget _reviewStep() {
    final settings = context.watch<AppState>().settings;
    final gross = (totalMinutes / 60) * settings.hourlyRate;
    final taxSetAside = gross *
        (settings.gstRate +
            settings.accRate +
            (settings.kiwiSaverEnabled ? settings.kiwiSaverRate : 0));
    final net = gross - taxSetAside;
    final customNote = noteController.text.trim();

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        _ReviewLine(label: 'Client', value: selectedClient ?? '-'),
        _ReviewLine(label: 'Type', value: selectedType.label),
        _ReviewLine(label: 'Date', value: formatDate(selectedDate)),
        _ReviewLine(
          label: 'Time',
          value:
              '${startTime == null ? '-' : formatTime(startTime!)} - ${finishTime == null ? '-' : formatTime(finishTime!)}',
        ),
        _ReviewLine(
          label: 'Duration',
          value:
              '${totalMinutes ~/ 60}h ${totalMinutes % 60}m (${(totalMinutes / 60).toStringAsFixed(2)} hrs)',
        ),
        if (selectedType == EntryType.homeVisit)
          _ReviewLine(
            label: 'Odometer',
            value:
                '${startOdometerController.text.trim().isEmpty ? '-' : startOdometerController.text.trim()} -> ${finishOdometerController.text.trim().isEmpty ? '-' : finishOdometerController.text.trim()}',
          ),
        if (selectedType == EntryType.homeVisit)
          _ReviewLine(label: 'KM', value: kilometres.toStringAsFixed(1)),
        _ReviewLine(label: 'Gross Earned', value: money(gross), highlight: true),
        _ReviewLine(label: 'Tax Set-Aside', value: money(taxSetAside)),
        _ReviewLine(label: 'Net Pay', value: money(net), highlight: true),
        if (selectedNotes.isNotEmpty || customNote.isNotEmpty) ...[
          const SizedBox(height: 16),
          Wrap(
            spacing: 8,
            runSpacing: 8,
            children: [
              for (final note in selectedNotes.toList()..sort())
                _SelectedPill(note),
              if (customNote.isNotEmpty) _SelectedPill(customNote),
            ],
          ),
        ],
      ],
    );
  }
}

const _schedulingNotes = {
  'Cancelled',
  'No Show',
  'Rescheduled',
  'Client Rescheduled',
  'Late Cancel',
  'Cut Short',
  'Follow-up Needed',
};

class _DarkShell extends StatelessWidget {
  const _DarkShell({required this.child});

  final Widget child;

  @override
  Widget build(BuildContext context) {
    return ColoredBox(
      color: const Color(0xFF0B0F18),
      child: child,
    );
  }
}

class _ProgressHeader extends StatelessWidget {
  const _ProgressHeader({
    required this.stepIndex,
    required this.stepCount,
    required this.periodText,
  });

  final int stepIndex;
  final int stepCount;
  final String periodText;

  @override
  Widget build(BuildContext context) {
    final progress = (stepIndex + 1) / stepCount;

    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        ClipRRect(
          borderRadius: BorderRadius.circular(999),
          child: LinearProgressIndicator(
            value: progress,
            minHeight: 4,
            backgroundColor: const Color(0xFF26314A),
            valueColor: const AlwaysStoppedAnimation(Color(0xFF4F8DF7)),
          ),
        ),
        const SizedBox(height: 12),
        Row(
          children: [
            Text(
              'STEP ${stepIndex + 1} OF $stepCount',
              style: const TextStyle(
                color: Color(0xFF7E91C5),
                fontSize: 12,
                fontWeight: FontWeight.w800,
                letterSpacing: 1.2,
              ),
            ),
            const Spacer(),
            Text(
              periodText,
              style: const TextStyle(
                color: Color(0xFF7E91C5),
                fontSize: 12,
                fontWeight: FontWeight.w700,
              ),
            ),
          ],
        ),
      ],
    );
  }
}

class _StepFrame extends StatelessWidget {
  const _StepFrame({
    required this.title,
    required this.subtitle,
    required this.child,
    required this.onBack,
    required this.onNext,
    this.showBack = true,
    this.isLast = false,
    this.nextLabel,
    this.trailingTopAction,
  });

  final String title;
  final String subtitle;
  final Widget child;
  final VoidCallback onBack;
  final VoidCallback onNext;
  final bool showBack;
  final bool isLast;
  final String? nextLabel;
  final Widget? trailingTopAction;

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.fromLTRB(28, 14, 28, 18),
      children: [
        if (trailingTopAction != null)
          Align(alignment: Alignment.centerRight, child: trailingTopAction),
        Text(
          title,
          style: const TextStyle(
            color: Colors.white,
            fontSize: 26,
            fontWeight: FontWeight.w900,
            letterSpacing: -0.5,
          ),
        ),
        const SizedBox(height: 8),
        Text(
          subtitle,
          style: const TextStyle(color: Color(0xFF7E91C5), fontSize: 15),
        ),
        const SizedBox(height: 24),
        child,
        const SizedBox(height: 80),
        Row(
          children: [
            if (showBack)
              Expanded(
                child: _NavButton(
                  label: '<- Back',
                  onPressed: onBack,
                  filled: false,
                ),
              ),
            if (showBack) const SizedBox(width: 10),
            Expanded(
              flex: showBack ? 2 : 1,
              child: _NavButton(
                label: isLast ? '💾 Save Entry' : nextLabel ?? 'Next ->',
                onPressed: onNext,
                filled: true,
                green: isLast,
              ),
            ),
          ],
        ),
      ],
    );
  }
}

class _ClientButton extends StatelessWidget {
  const _ClientButton({
    required this.label,
    required this.selected,
    required this.onTap,
  });

  final String label;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return _BigTapBox(
      selected: selected,
      onTap: onTap,
      child: Column(
        mainAxisAlignment: MainAxisAlignment.center,
        children: [
          const Text('👤', style: TextStyle(fontSize: 28)),
          const SizedBox(height: 12),
          Text(
            label,
            style: const TextStyle(
              color: Colors.white,
              fontSize: 20,
              fontWeight: FontWeight.w900,
            ),
          ),
        ],
      ),
    );
  }
}

class _ContactTypeButton extends StatelessWidget {
  const _ContactTypeButton({
    required this.icon,
    required this.title,
    required this.subtitle,
    required this.selected,
    required this.onTap,
  });

  final String icon;
  final String title;
  final String subtitle;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 12),
      child: InkWell(
        borderRadius: BorderRadius.circular(14),
        onTap: onTap,
        child: Container(
          width: double.infinity,
          padding: const EdgeInsets.all(18),
          decoration: BoxDecoration(
            color: const Color(0xFF171D2B),
            borderRadius: BorderRadius.circular(14),
            border: Border.all(
              color: selected ? const Color(0xFF4F8DF7) : const Color(0xFF34405F),
              width: selected ? 2 : 1,
            ),
          ),
          child: Row(
            children: [
              Text(icon, style: const TextStyle(fontSize: 24)),
              const SizedBox(width: 16),
              Expanded(
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Text(
                      title,
                      style: const TextStyle(
                        color: Colors.white,
                        fontSize: 17,
                        fontWeight: FontWeight.w900,
                      ),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      subtitle,
                      style: const TextStyle(color: Color(0xFF667AAE)),
                    ),
                  ],
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }
}

class _BigTapBox extends StatelessWidget {
  const _BigTapBox({
    required this.child,
    required this.selected,
    required this.onTap,
  });

  final Widget child;
  final bool selected;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      borderRadius: BorderRadius.circular(14),
      onTap: onTap,
      child: Container(
        width: 184,
        height: 126,
        decoration: BoxDecoration(
          color: const Color(0xFF171D2B),
          borderRadius: BorderRadius.circular(14),
          border: Border.all(
            color: selected ? const Color(0xFF4F8DF7) : const Color(0xFF34405F),
            width: selected ? 2 : 1,
          ),
        ),
        child: child,
      ),
    );
  }
}

class _DarkInputButton extends StatelessWidget {
  const _DarkInputButton({
    required this.text,
    required this.icon,
    required this.onTap,
  });

  final String text;
  final IconData icon;
  final VoidCallback onTap;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      borderRadius: BorderRadius.circular(10),
      onTap: onTap,
      child: Container(
        height: 54,
        padding: const EdgeInsets.symmetric(horizontal: 16),
        decoration: BoxDecoration(
          color: const Color(0xFF202638),
          borderRadius: BorderRadius.circular(10),
          border: Border.all(color: const Color(0xFF34405F)),
        ),
        child: Row(
          children: [
            Expanded(
              child: Text(
                text,
                style: const TextStyle(color: Colors.white, fontSize: 17),
              ),
            ),
            Icon(icon, color: const Color(0xFF8EA0D0)),
          ],
        ),
      ),
    );
  }
}

class _LargeActionButton extends StatelessWidget {
  const _LargeActionButton({required this.label, required this.onPressed});

  final String label;
  final VoidCallback onPressed;

  @override
  Widget build(BuildContext context) {
    return OutlinedButton(
      onPressed: onPressed,
      style: OutlinedButton.styleFrom(
        foregroundColor: const Color(0xFFB7C6EE),
        side: const BorderSide(color: Color(0xFF34405F), width: 2),
        padding: const EdgeInsets.symmetric(vertical: 18),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(12)),
      ),
      child: Text(label, style: const TextStyle(fontWeight: FontWeight.w900)),
    );
  }
}

class _GreenOutlinePanel extends StatelessWidget {
  const _GreenOutlinePanel({required this.text, this.onTap});

  final String text;
  final VoidCallback? onTap;

  @override
  Widget build(BuildContext context) {
    return InkWell(
      onTap: onTap,
      borderRadius: BorderRadius.circular(12),
      child: Container(
        width: double.infinity,
        padding: const EdgeInsets.all(18),
        decoration: BoxDecoration(
          color: const Color(0xFF0D2A1D),
          borderRadius: BorderRadius.circular(12),
          border: Border.all(color: const Color(0xFF1DB954), width: 2),
        ),
        child: Text(
          text,
          textAlign: TextAlign.center,
          style: const TextStyle(
            color: Color(0xFF31E981),
            fontWeight: FontWeight.w900,
          ),
        ),
      ),
    );
  }
}

class _EarnedPanel extends StatelessWidget {
